{
  "manifest_version": 3,
  "name": "DevOps to Markdown",
  "version": "0.1.0",
  "description": "Convert an Azure DevOps work item into clean Markdown for your clipboard.",
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "DevOps to Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  }
}
